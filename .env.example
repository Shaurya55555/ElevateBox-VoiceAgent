# Copy to .env and fill in — never commit the real .env

# Vapi (orchestration) — https://vapi.ai, BYOK mode
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Exotel (telephony, KYC-gated not payment-gated — see README)
EXOTEL_SID=
EXOTEL_SUBDOMAIN=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_EXOPHONE=

# Deepgram (STT: Nova-3, TTS: Aura-2) — https://deepgram.com/console
DEEPGRAM_API_KEY=

# Groq (fast in-conversation LLM turns) — https://console.groq.com
GROQ_API_KEY=

# Gemini (extraction/classification between turns) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Meta WhatsApp Cloud API (developers.facebook.com) — free in test mode
# for verified test recipients
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=

# Public HTTPS URL this backend is reachable at (Vapi needs this for
# serverUrl tool-call + end-of-call webhooks) — an ngrok tunnel during dev,
# the Render/Railway URL once deployed
WEBHOOK_BASE_URL=

# Public URLs the post-call WhatsApp hands off for attachments — raw
# GitHub URLs once this repo is pushed:
RESUME_PUBLIC_URL=https://raw.githubusercontent.com/Shaurya55555/ElevateBox-VoiceAgent/master/resume.pdf
ARCHITECTURE_IMAGE_URL=https://raw.githubusercontent.com/Shaurya55555/ElevateBox-VoiceAgent/master/architecture.png

# Interim test target while Exotel KYC is pending; swap to +918688664337
# once approved
TARGET_PHONE_NUMBER=+917985200306
SHAURYA_PHONE_DISPLAY=+91-7985200306
PORT=8000
