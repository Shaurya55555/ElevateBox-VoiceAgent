# Copy to .env and fill in — never commit the real .env

# Twilio (free trial — sign up with Indian account details, verify
# 8688664337 as a caller ID via SMS, trial credit covers the number + minutes)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Cloud (Speech-to-Text + Text-to-Speech, both free tier)
# Point this at a service-account JSON key file:
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Gemini API (free tier, no card) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Meta WhatsApp Cloud API (developers.facebook.com) — free in test mode
# for verified test recipients
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=

# Public HTTPS URL of app.py (e.g. an ngrok tunnel) — Twilio needs this to
# fetch /twiml and connect /media-stream
WEBHOOK_BASE_URL=

# Public URLs the WhatsApp follow-up can hand off for attachments — raw
# GitHub URLs once this repo is pushed:
RESUME_PUBLIC_URL=https://raw.githubusercontent.com/Shaurya55555/ElevateBox-VoiceAgent/main/resume.pdf
ARCHITECTURE_IMAGE_URL=https://raw.githubusercontent.com/Shaurya55555/ElevateBox-VoiceAgent/main/architecture.png

TARGET_PHONE_NUMBER=+918688664337
PORT=8000
