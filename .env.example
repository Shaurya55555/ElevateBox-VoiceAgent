# Copy to .env and fill in — never commit the real .env
OMNIDIM_API_KEY=

# Meta WhatsApp Cloud API (developers.facebook.com)
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=

# Public HTTPS URL of webhook_server.py (e.g. an ngrok tunnel or a deployed host)
WEBHOOK_BASE_URL=

# Public URLs the webhook can hand to WhatsApp for attachments — e.g. raw
# GitHub URLs once this repo is pushed:
# https://raw.githubusercontent.com/Shaurya55555/<repo>/main/resume.pdf
RESUME_PUBLIC_URL=
ARCHITECTURE_IMAGE_URL=

TARGET_PHONE_NUMBER=+918688664337
PORT=8000
